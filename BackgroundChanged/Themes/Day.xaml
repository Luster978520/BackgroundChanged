<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ForegroundBrush" Color="#203F52"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#526F80"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F7FA"/>
    <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#30203F52"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B718C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#183B718C"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#E5EFF5"/>
    <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A6FFFFFF" Offset="0"/><GradientStop Color="#55EDF9FF" Offset="0.5"/><GradientStop Color="#80FFFFFF" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#A8FFFFFF"/>
    <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#85FFFFFF"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#BBFFFFFF"/>
</ResourceDictionary>

