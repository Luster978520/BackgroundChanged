<Window x:Class="BackgroundChanged.View.SelfUserControlFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackgroundChanged.View"
        mc:Ignorable="d"
        xmlns:UC="clr-namespace:BackgroundChanged.Controls"
        Title="SelfUserControlFrm" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <UC:ColorPickerUC x:Name="ColorPickerUc" MyColor="Red" ColorChanged="ColorPickerUC_ColorChanged"> </UC:ColorPickerUC>
           
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0">
            <StackPanel Margin="20">
                <TextBlock Height="30" Background="Pink" FontFamily="宋体" Foreground="Black" FontSize="20" x:Name="ucColorTestShow" Text="111"></TextBlock>
                <Button  Height="40" Background="Orange" Width="80" Command="Undo" CommandTarget="{Binding ElementName=ColorPickerUc}"></Button>
                <Button  Height="40" Background="Orange" Width="80" Click="Button_Click"></Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="30" Grid.Column="1">
            <Button Content="1. 外部直接调用委托"
                Height="40" Margin="0,0,0,10"
                Click="CallDelegate_Click"/>

            <Button Content="2. 启动设备，由内部引发事件"
                Height="40" Margin="0,0,0,10"
                Click="StartDevice_Click"/>

            <Button Content="3. 取消事件订阅"
                Height="40" Margin="0,0,0,10"
                Click="Unsubscribe_Click"/>

            <Button Content="4. 重新订阅事件"
                Height="40"
                Click="Subscribe_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock FontFamily="宋体" Foreground="Black" FontSize="20">
                <TextBlock.Text>
                   控件添加事件  
                    注册事件
                    公开
                    触发事件
                </TextBlock.Text>
                
            </TextBlock>
            <ListBox>
                <ListBoxItem> </ListBoxItem>
                <ListBoxItem> </ListBoxItem>
                <ListBoxItem> </ListBoxItem>
                <ListBoxItem> </ListBoxItem>
                <ListBoxItem> </ListBoxItem>
                <ListBoxItem> </ListBoxItem>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
    