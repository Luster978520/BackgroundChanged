<Window x:Class="BackgroundChanged.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BackgroundChanged.Controls"
        Title="昼夜之间 · Daylight" Width="1180" Height="800" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}" UseLayoutRounding="True">
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}"/></Window.InputBindings>
    <Grid x:Name="SceneInput" ClipToBounds="True" Background="Transparent">
        <!-- Both scenes stay alive so interrupted transitions continue from the current opacity. -->
        <Grid Background="#D4E4EB"><Border Background="{Binding DayBackground}"/><Border Background="#E5EFF5" Opacity="{Binding DayOverlay}"/></Grid>
        <Grid x:Name="NightLayer" Opacity="0" Background="#111A38" IsHitTestVisible="False"><Border Background="{Binding NightBackground}"/><Border Background="#0B142A" Opacity="{Binding NightOverlay}"/></Grid>
        <Grid Margin="38,26,38,24" x:Name="MainContent">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,10,0"><Grid><Ellipse Width="14" Height="14" Fill="{DynamicResource ForegroundBrush}"/><Ellipse Width="11" Height="14" Fill="{DynamicResource SurfaceBrush}" Margin="7,-4,0,0"/></Grid></Border>
                    <StackPanel><TextBlock Text="昼夜之间" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="D A Y L I G H T" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                    <Button x:Name="LauncherToggle" Click="ToggleLauncher_Click" Margin="24,0,0,0" Padding="12,10"
                            ToolTip="收起功能面板" AutomationProperties.Name="收起功能面板">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LauncherToggleLabel" Text="收起空间" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button  Click="SelfUserControl_Click" Margin="24,0,0,0" Padding="12,10"
                                ToolTip="自定义按钮"  >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock  Text="自定义按钮" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FlipPanelButton" Content="3D 翻转面板" Click="FlipPanel_Click" Margin="16,0,0,0" Padding="12,10"
                            ToolTip="打开 FlipPanel 演示" AutomationProperties.Name="打开 3D 翻转面板" FontSize="12"/>
                    <Button x:Name="dataSource" Content="studyBingding"  Margin="16,0,0,0" Padding="12,10" Click="dataSource_Click"
        ToolTip="study"  FontSize="12"/>
                </StackPanel>
                <Button x:Name="SettingsButton" HorizontalAlignment="Right" Command="{Binding ToggleSettingsCommand}" ToolTip="为日间与夜间分别设置背景" AutomationProperties.Name="背景设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="背景设置" FontSize="12"/></StackPanel></Button>
            </Grid>
           
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="LauncherColumn" Width="250"/><ColumnDefinition x:Name="LauncherGap" Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="0.85*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.15*"/></Grid.RowDefinitions>
                <controls:GlassLauncher x:Name="Launcher" Grid.RowSpan="3" Margin="0,30,0,30" FeatureRequested="OnFeatureRequested"/>
                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TimeText}" FontFamily="Segoe UI Light" FontWeight="Light" FontSize="82" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DateText}" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" FontSize="13" Margin="0,1,0,30"/>
                    <TextBlock Text="{Binding ModeTitle}" FontSize="25" FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,11"/>
                    <TextBlock Text="{Binding ModeCaption}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <controls:DayNightSwitch x:Name="ThemeSwitch" Width="320" Height="159" IsNight="{Binding IsNight, Mode=TwoWay}"/>
                    <Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="12,5" HorizontalAlignment="Center" Margin="0,25,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding ModeLabel}" FontSize="11"/></StackPanel></Border>
                    <TextBlock Text="{Binding SwitchHint}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2"><TextBlock Text="一键昼夜，各有风景" Opacity="0.75" FontSize="11"/><TextBlock Text="YOUR SPACE. YOUR PACE." Opacity="0.75" FontSize="10" HorizontalAlignment="Right"/></Grid>
        </Grid>
        <controls:MouseTrailOverlay x:Name="MouseTrail" InputSource="{Binding ElementName=SceneInput}"
            IsTrailEnabled="{Binding MouseTrailSettings.IsEnabled}" Lifetime="{Binding MouseTrailSettings.Lifetime}"
            Intensity="{Binding MouseTrailSettings.Intensity}" TrailWidth="{Binding MouseTrailSettings.TrailWidth}"
            Palette="{Binding MouseTrailSettings.Palette}" RespectReducedMotion="{Binding MouseTrailSettings.RespectReducedMotion}"
            IsNight="{Binding IsNight}" IsPaused="{Binding IsSettingsOpen}"/>
        <Grid x:Name="SettingsOverlay" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanVisibility}}">
            <Button Background="#60091425" BorderThickness="0" Command="{Binding CloseSettingsCommand}" Focusable="False" AutomationProperties.Name="关闭背景设置"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template></Button>
            <Border x:Name="SettingsDrawer" Width="370" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" KeyboardNavigation.TabNavigation="Cycle">
                <Border.RenderTransform><TranslateTransform x:Name="DrawerTranslation"/></Border.RenderTransform>
                <Grid Margin="25,26,25,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="你的专属风景" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="背景与流光，随心设置。" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,7,0,0"/></StackPanel><Button Content="×" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,2" FontSize="22" Background="Transparent" BorderThickness="0" ToolTip="关闭设置 (Esc)"/></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,5,12">
                            <TextBlock Text="选择要编辑的主题" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Command="{Binding SelectDayCommand}" Padding="4" AutomationProperties.Name="编辑日间背景">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding EditingMode}" Value="0"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <StackPanel><Border Height="68" Width="132" CornerRadius="8" Background="{Binding DayBackground}"/><TextBlock Text="日间" HorizontalAlignment="Center" FontSize="12" Margin="0,8,0,5"/></StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding SelectNightCommand}" Padding="4" AutomationProperties.Name="编辑夜间背景">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding EditingMode}" Value="1"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <StackPanel><Border Height="68" Width="132" CornerRadius="8" Background="{Binding NightBackground}"/><TextBlock Text="夜间" HorizontalAlignment="Center" FontSize="12" Margin="0,8,0,5"/></StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding BackgroundKinds}" SelectedItem="{Binding BackgroundKind, Mode=TwoWay}" Margin="0,0,0,16" AutomationProperties.Name="背景类型"/>
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BackgroundKind}" Value="纯色"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="背景颜色" FontSize="12" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SolidColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="输入十六进制颜色，例如 #89B8DF" Margin="0,0,0,6" AutomationProperties.Name="背景颜色值"/>
                                <TextBlock Text="输入颜色值，例如 #89B8DF，移开焦点后生效" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,16"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BackgroundKind}" Value="图片"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <Button Content="＋  选择本地图片" Command="{Binding ChooseImageCommand}" IsEnabled="{Binding CanImport}"/>
                                <TextBlock Text="{Binding ImageName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" Margin="0,8,0,14"/>
                                <CheckBox Content="完整显示图片（可能留边）" IsChecked="{Binding ShowWholeImage}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Text="默认填满窗口并裁剪边缘；图片会复制到本机应用目录。" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,16"/>
                            </StackPanel>
                            <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,20"><TextBlock Text="白天和夜晚独立保存。编辑另一套背景后，点击主界面的开关即可查看效果。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" LineHeight="19"/></Border>
                            <Grid><TextBlock Text="柔和遮罩" FontSize="12"/><TextBlock Text="{Binding OverlayText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
                            <Slider Minimum="0" Maximum="0.7" Value="{Binding Overlay, Mode=TwoWay}" TickFrequency="0.05" Margin="0,12,0,6" AutomationProperties.Name="背景遮罩强度"/>
                            <TextBlock Text="降低背景干扰，让时间与文字更清晰。" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,22"/>
                            <Button Content="恢复当前背景的默认设置" Command="{Binding ResetCommand}" Background="Transparent" FontSize="12"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,22,0,0">
                                <StackPanel DataContext="{Binding MouseTrailSettings}">
                                    <TextBlock Text="鼠标流光" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <CheckBox Content="启用流光拖尾" IsChecked="{Binding IsEnabled}" FontSize="12" Margin="0,0,0,8" AutomationProperties.Name="启用流光拖尾"/>
                                    <TextBlock Text="移动鼠标留下渐变光带，停止后自然消散。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,16"/>
                                    <StackPanel IsEnabled="{Binding IsEnabled}">
                                        <TextBlock Text="配色方案" FontSize="12" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding Palettes}" SelectedItem="{Binding Palette, Mode=TwoWay}" Margin="0,0,0,18" AutomationProperties.Name="拖尾配色"/>
                                        <Grid><TextBlock Text="留影时长" FontSize="12"/><TextBlock Text="{Binding LifetimeText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
                                        <Slider Minimum="0.2" Maximum="1.5" TickFrequency="0.05" Value="{Binding Lifetime, Mode=TwoWay}" Margin="0,10,0,16" AutomationProperties.Name="拖尾留影时长"/>
                                        <Grid><TextBlock Text="光效强度" FontSize="12"/><TextBlock Text="{Binding IntensityText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
                                        <Slider Minimum="0.1" Maximum="1" TickFrequency="0.05" Value="{Binding Intensity, Mode=TwoWay}" Margin="0,10,0,16" AutomationProperties.Name="拖尾光效强度"/>
                                        <Grid><TextBlock Text="光带宽度" FontSize="12"/><TextBlock Text="{Binding WidthText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
                                        <Slider Minimum="3" Maximum="10" TickFrequency="0.5" Value="{Binding TrailWidth, Mode=TwoWay}" Margin="0,10,0,16" AutomationProperties.Name="拖尾光带宽度"/>
                                        <CheckBox Content="遵循系统的减少动画设置" IsChecked="{Binding RespectReducedMotion}" FontSize="12" Margin="0,0,0,12"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock Text="关闭面板后移动鼠标查看效果。打开设置时暂停生成新轨迹；单色呼吸使用参考图中的绿色。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" LineHeight="19"/></Border>
                                    <Button Content="恢复默认流光效果" Command="{Binding ResetCommand}" Background="Transparent" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/></Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

