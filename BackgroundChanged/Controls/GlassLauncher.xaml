<UserControl x:Class="BackgroundChanged.Controls.GlassLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="FeatureButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="18" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="16" BorderThickness="0,1,0,0" BorderBrush="#45FFFFFF" Margin="-9,-10,-9,0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassThumb" TargetType="Thumb">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border Background="{DynamicResource AccentBrush}" Opacity="0.4" CornerRadius="3" Margin="2,0"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource GlassThumb}" MinHeight="28"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LauncherGrid">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border CornerRadius="30" Background="#180C203C" Margin="2,7,2,0" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#08152D" BlurRadius="24" ShadowDepth="7" Opacity="0.18"/></Border.Effect>
        </Border>
        <Border CornerRadius="30" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
            <Grid>
                <Border CornerRadius="29" BorderThickness="1,1,0,0" BorderBrush="#65FFFFFF" Margin="1" IsHitTestVisible="False"/>
                <Grid Margin="18,23,14,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="5,0,0,20">
                        <TextBlock Text="工 作 空 间" Foreground="{DynamicResource SecondaryBrush}" FontSize="9"/>
                        <Grid Margin="0,8,4,0">
                            <TextBlock Text="随心开启" FontSize="22" FontWeight="SemiBold"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9" Background="{DynamicResource GlassCardBrush}" Padding="7,3">
                                <TextBlock Text="{Binding Features.Count, ElementName=Root}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="把常用的，都放在手边。" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="FeatureScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                                  Visibility="{Binding IsExpanded, ElementName=Root, Converter={StaticResource BooleanVisibility}}">
                        <ItemsControl x:Name="FeatureItems" ItemsSource="{Binding Features, ElementName=Root}" Margin="0,0,5,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FeatureButton}" Click="Feature_Click" Tag="{Binding Id}"
                                            ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/></Grid.ColumnDefinitions>
                                            <Border Width="31" Height="34" CornerRadius="11" Background="{Binding Tint}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdgeBrush}" Margin="5,8,9,0" Padding="0,12,0,0">
                        <Button x:Name="ListToggle" Click="ToggleList_Click" Padding="0,5" HorizontalContentAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="ToolTip" Value="展开功能按钮"/>
                                    <Setter Property="AutomationProperties.Name" Value="展开功能按钮"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                                            <Setter Property="ToolTip" Value="收起功能按钮"/>
                                            <Setter Property="AutomationProperties.Name" Value="收起功能按钮"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE74B;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                                                <Setter Property="Text" Value="&#xE74A;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
